+/// One-block messages (`prefix || body`, at most 55 bytes): stages one block per lane and
+/// writes only digest word 0 per message, skipping the byte-wise digest output.
+#[inline(always)]
+pub(crate) fn heads_lanes<L: Lanes, const W: usize>(prefix: &[u8], bodies: &[&[u8]], out: &mut [u32]) {
+    const { assert!(L::N == W) };
+    let n = bodies.len();
+    assert!(n <= L::N && out.len() == n);
+    let mut blocks = [[0u8; BLOCK]; W];
+    let mut srcs: [*const u8; W] = [std::ptr::null(); W];
+    let p = prefix.len();
+    for (i, body) in bodies.iter().enumerate() {
+        let l = p + body.len();
+        assert!(l <= 55);
+        let blk = &mut blocks[i];
+        blk[..p].copy_from_slice(prefix);
+        blk[p..l].copy_from_slice(body);
+        blk[l] = 0x80;
+        blk[56..].copy_from_slice(&((l as u64) * 8).to_be_bytes());
+        srcs[i] = blk.as_ptr();
+    }
+    // SAFETY: the first n lanes point at full 64-byte blocks.
+    let w = unsafe { L::transpose(&srcs, n) };
+    let mut state = H0.map(L::splat);
+    compress::<L>(&mut state, w);
+    let mut tmp = [0u32; W];
+    state[0].store(&mut tmp[..L::N]);
+    out.copy_from_slice(&tmp[..n]);
+}
