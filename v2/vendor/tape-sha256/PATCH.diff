+/// First 32 bits of `SHA-256(prefix || body)` (big-endian) for each body.
+///
+/// Fast path: AVX2 without AVX-512, every `prefix || body` at most 55 bytes (one block).
+/// Everything else goes through [`hash_many_prefixed`], so results are always identical.
+///
+/// # Panics
+///
+/// Panics if `bodies.len() != out.len()`.
+pub fn hash_short_heads(prefix: &[u8], bodies: &[&[u8]], out: &mut [u32]) {
+    assert_eq!(bodies.len(), out.len());
+    #[cfg(all(target_arch = "x86_64", not(feature = "scalar")))]
+    if is_x86_feature_detected!("avx2")
+        && !is_x86_feature_detected!("avx512f")
+        && bodies.iter().all(|b| prefix.len() + b.len() <= 55)
+    {
+        for (b, o) in bodies.chunks(8).zip(out.chunks_mut(8)) {
+            // SAFETY: AVX2 detected above.
+            unsafe { avx2::heads(prefix, b, o) }
+        }
+        return;
+    }
+    let mut full = [[0u8; 32]; 128];
+    for (b, o) in bodies.chunks(128).zip(out.chunks_mut(128)) {
+        hash_many_prefixed(prefix, b, &mut full[..b.len()]);
+        for (d, w) in full.iter().zip(o.iter_mut()) {
+            *w = u32::from_be_bytes([d[0], d[1], d[2], d[3]]);
+        }
+    }
+}
